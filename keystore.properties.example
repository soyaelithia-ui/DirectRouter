# Copy this file to keystore.properties (ignored by git) for local signed release builds.
# Never commit real keystores or passwords to the repository.
#
# Alternatively, provide these via environment variables (used by CI):
#   DIRECTROUTER_KEYSTORE_PATH (or KEYSTORE_PATH / KEYSTORE_FILE)
#   DIRECTROUTER_KEYSTORE_PASSWORD (or KEYSTORE_PASSWORD)
#   DIRECTROUTER_KEY_ALIAS (or KEY_ALIAS)
#   DIRECTROUTER_KEY_PASSWORD (or KEY_PASSWORD)

storeFile=/absolute/or/relative/path/to/release.jks
storePassword=change_me_store_password
keyAlias=directrouter
keyPassword=change_me_key_password
